# Copy to /opt/sub2api/.env on the server and fill real values there.
# Do not commit /opt/sub2api/.env or any copied local .env file.

BIND_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

# Prefer an explicit immutable tag for planned upgrades.
# Use latest only when intentionally tracking upstream latest.
SUB2API_IMAGE=weishaw/sub2api:latest

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=change_this_to_a_long_random_value
POSTGRES_DB=sub2api

# Set Redis password for production.
REDIS_PASSWORD=change_this_to_a_long_random_value
REDIS_DB=0

ADMIN_EMAIL=admin@example.com
# First-run bootstrap only. Changing this later does not rotate an existing admin password.
ADMIN_PASSWORD=change_this_to_a_long_random_value

# Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_64_hex_chars
TOTP_ENCRYPTION_KEY=change_this_to_64_hex_chars

# Optional OAuth/provider settings.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_SCOPES=
GEMINI_QUOTA_POLICY=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_USER_AGENT_VERSION=
GATEWAY_ANTIGRAVITY_FORWARD_BASE_URL=prod

# Optional network/update proxy.
UPDATE_PROXY_URL=

# Conservative defaults matching upstream Docker config.
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=10
REDIS_ENABLE_TLS=false

SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=
