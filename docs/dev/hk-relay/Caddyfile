# Rollback only. Since 2026-10-21 the live relay is HAProxy TCP splice
# (haproxy.cfg in this directory, /etc/haproxy/haproxy.cfg on the box).
# Caddy is installed and this file is still /etc/caddy/Caddyfile, but the
# service is disabled. To roll back: systemctl stop haproxy && systemctl enable --now caddy
#
# hk-relay: HTTPS customer/operator entry + leftover IP HTTP for operator tests.
# Public URL to hand out: https://zerocode.kaynlab.asia
# Do not give http://191.40.32.186 to customers (Authorization is cleartext).
#
# On the box this text is still /etc/caddy/Caddyfile, kept for rollback.
# Copy: scp -i $HOME\.ssh\id_ed25519_yt_hk -o IdentitiesOnly=yes docs/dev/hk-relay/Caddyfile root@191.40.32.186:/etc/caddy/Caddyfile

{
	admin 127.0.0.1:2019
	servers {
		protocols h1
		timeouts {
			read_body 3600s
			read_header 60s
			write 3600s
			idle 3600s
			# Abort a write that makes no progress for 60s. A completed write
			# resets the clock, so a live stream is not cut. Requires Caddy >= 2.11.7.
			write_idle 60s
			write_max_chunk 16KiB
		}
		max_header_size 1MB
	}
}

(origin_proxy) {
	request_body {
		max_size 256MB
	}

	reverse_proxy https://zerocode.kaynlab.com {
		header_up Host zerocode.kaynlab.com
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host zerocode.kaynlab.com
		# Public site the client used. Origin Caddy keeps this only from the relay peer.
		header_up X-Sub2-Entry-Host {http.request.host}
		header_up -X-Sub2-Entry-Via
		flush_interval -1

		transport http {
			versions 1.1
			compression off
			read_timeout 3600s
			write_timeout 3600s
			dial_timeout 30s
			keepalive 120s
			keepalive_idle_conns 64
		}
	}

	log {
		output file /var/log/caddy/hk-relay.log {
			roll_size 50mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
		level INFO
	}
	# Join this value to usage_logs.request_id as client:<id>. Not reloaded on the box in this change.
	log_append x_request_id {http.response.header.X-Request-Id}
}

zerocode.kaynlab.asia {
	import origin_proxy
}

http://191.40.32.186 {
	import origin_proxy
}
