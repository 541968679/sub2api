# hk-relay: HTTPS customer/operator entry + leftover IP HTTP for operator tests.
# Public URL to hand out: https://zerocode.kaynlab.asia
# Do not give http://191.40.32.186 to customers (Authorization is cleartext).
#
# Live path on the box: /etc/caddy/Caddyfile
# Copy: scp -i $HOME\.ssh\id_ed25519_yt_hk -o IdentitiesOnly=yes docs/dev/hk-relay/Caddyfile root@191.40.32.186:/etc/caddy/Caddyfile

{
	admin 127.0.0.1:2019
	servers {
		protocols h1 h2 h2c
		timeouts {
			read_body 3600s
			read_header 60s
			write 3600s
			idle 3600s
		}
		max_header_size 1MB
	}
}

(origin_proxy) {
	request_body {
		max_size 256MB
	}

	reverse_proxy https://zerocode.kaynlab.com {
		header_up Host zerocode.kaynlab.com
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host zerocode.kaynlab.com
		flush_interval -1

		transport http {
			versions 1.1 2
			compression off
			read_timeout 3600s
			write_timeout 3600s
			dial_timeout 30s
			keepalive 120s
			keepalive_idle_conns 64
		}
	}

	log {
		output file /var/log/caddy/hk-relay.log {
			roll_size 50mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
		level INFO
	}
}

zerocode.kaynlab.asia {
	import origin_proxy
}

http://191.40.32.186 {
	import origin_proxy
}
