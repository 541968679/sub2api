# Recorded from new-origin on 2026-10-16. This file is not the live Caddyfile.
# Encode for text/event-stream was already reloaded that day
# (backup /etc/caddy/Caddyfile.bak-sse-encode-20261016).
# The X-Sub2-Entry-Host rules below are not on the box yet. Reload them only
# with a separate approval. Do not copy this snippet onto a2 or InvokeAI.

zerocode.kaynlab.com {
	encode {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type text/plain*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/xhtml+xml*
			header Content-Type application/atom+xml*
			header Content-Type application/rss+xml*
			header Content-Type image/svg+xml*
			header Content-Type application/xml*
			header Content-Type font/*
		}
		zstd gzip
	}

	# Hong Kong relay is the only peer allowed to name the public entry host.
	# Other clients, including ones that send these headers themselves, lose them.
	@from_hk remote_ip 191.40.32.186
	handle @from_hk {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
			header_up X-Sub2-Entry-Host {http.request.header.X-Sub2-Entry-Host}
			header_up X-Sub2-Entry-Via hk-relay
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
			header_up -X-Sub2-Entry-Host
			header_up -X-Sub2-Entry-Via
		}
	}
}
