	bind 127.0.0.1
	tls {
		issuer acme {
			profile shortlived
			disable_http_challenge
		}
	}
	request_body {
		max_size 256MB
	}
	reverse_proxy http://15.204.102.44:8088 {
		flush_interval -1
		header_up X-Real-IP {remote_host}
	}
}
